+ */
+package org.teavm.backend.wasm;
+
+import java.util.ArrayDeque;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import org.teavm.callgraph.CallGraph;
+import org.teavm.callgraph.CallGraphNode;
+import org.teavm.callgraph.CallSite;
+import org.teavm.interop.Async;
+import org.teavm.model.ClassReader;
+import org.teavm.model.ListableClassReaderSource;
+import org.teavm.model.MethodReader;
+import org.teavm.model.MethodReference;
+
+final class WjAsyncReport {
+    private WjAsyncReport() {
+    }
+
+    static void print(CallGraph callGraph, ListableClassReaderSource classes, Set<MethodReference> asyncMethods,
+            boolean hasThreads) {
+        System.out.println("[wj-async] " + asyncMethods.size() + " async methods, threads " + hasThreads);
+        for (MethodReference m : asyncMethods) {
+            ClassReader cls = classes.get(m.getClassName());
+            MethodReader method = cls != null ? cls.getMethod(m.getDescriptor()) : null;
+            if (method == null || method.getAnnotations().get(Async.class.getName()) == null) {
+                continue;
+            }
+            System.out.println("[wj-async] root " + m);
+            Map<MethodReference, MethodReference> next = new HashMap<>();
+            ArrayDeque<MethodReference> queue = new ArrayDeque<>();
+            queue.add(m);
+            next.put(m, null);
+            MethodReference user = null;
+            while (!queue.isEmpty() && user == null) {
+                MethodReference cur = queue.poll();
+                CallGraphNode node = callGraph.getNode(cur);
+                if (node == null) {
+                    continue;
+                }
+                for (CallSite site : node.getCallerCallSites()) {
+                    for (CallGraphNode caller : site.getCallers()) {
+                        MethodReference c = caller.getMethod();
+                        if (next.containsKey(c)) {
+                            continue;
+                        }
+                        next.put(c, cur);
+                        String n = c.getClassName();
+                        if (!n.startsWith("java.") && !n.startsWith("org.teavm.")) {
+                            user = c;
+                            break;
+                        }
+                        queue.add(c);
+                    }
+                    if (user != null) {
+                        break;
+                    }
+                }
+            }
+            for (MethodReference c = user; c != null; c = next.get(c)) {
+                System.out.println("[wj-async]     " + c);
+            }
+        }
+    }
+}
