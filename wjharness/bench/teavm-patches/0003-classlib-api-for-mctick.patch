+/*
+ *  wjharness patch 0003: StreamSupport.intStream(Spliterator.OfInt, boolean).
+ *
+ *  Licensed under the Apache License, Version 2.0 (the "License"), as TeaVM.
+ */
+package org.teavm.classlib.java.util.stream.intimpl;
+
+import java.util.Spliterator;
+import java.util.function.IntConsumer;
+import java.util.function.IntPredicate;
+
+public class TSpliteratorIntStreamImpl extends TSimpleIntStreamImpl {
+    private final Spliterator.OfInt spliterator;
+    private boolean exhausted;
+
+    public TSpliteratorIntStreamImpl(Spliterator.OfInt spliterator) {
+        this.spliterator = spliterator;
+    }
+
+    @Override
+    public boolean next(IntPredicate consumer) {
+        boolean[] keep = new boolean[1];
+        IntConsumer push = v -> keep[0] = consumer.test(v);
+        while (!exhausted) {
+            keep[0] = true;
+            if (!spliterator.tryAdvance(push)) {
+                exhausted = true;
+                break;
+            }
+            if (!keep[0]) {
+                break;
+            }
+        }
+        return !exhausted;
+    }
+}
