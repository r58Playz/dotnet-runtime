+    /*
+     * A method whose program the inliner dropped (no SPECIAL callers left) can still have a declared function, which
+     * generateMethods skipped: an empty body, invalid wasm when the method has a result, and a silent no-op when it
+     * is void. Make it trap, and say how many there were.
+     */
+    private void fillMethodsWithoutProgram(WasmModule module, WasmFunctionRepository functions) {
+        var candidates = new java.util.HashMap<WasmFunction, MethodHolder>();
+        for (var method : methodsWithoutProgram) {
+            var function = functions.findMethod(method);
+            if (function != null) {
+                candidates.put(function, method);
+            }
+        }
+        int filled = 0;
+        var names = new StringBuilder();
+        for (var function : module.functions) {
+            var method = candidates.get(function);
+            if (method != null && function.getImportName() == null && function.getBody().isEmpty()) {
+                function.getBody().add(new org.teavm.backend.wasm.model.expression.WasmUnreachable());
+                if (filled++ < 20) {
+                    names.append(filled == 1 ? "" : ", ").append(method.getReference());
+                }
+            }
+        }
+        System.out.println("wj: methods declared without a program: " + filled + (filled > 0 ? " (" + names
+                + (filled > 20 ? ", ..." : "") + ")" : ""));
+    }
