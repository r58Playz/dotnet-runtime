# The harness's per-machine configuration. Copy to ~/.config/wjharness/machine.env (or point $WJ_MACHINE_ENV at a
# file) and fill in what this machine has. KEY=VALUE per line; ~, $HOME and ${KEY} expand. The process environment
# overrides every key. `wj doctor` shows what resolved and what is missing; `wj paths` prints it all.
#
# Only IKVMCRAFT is needed for the Minecraft and jbox2d drivers. Every other checkout gates single tools, which refuse by
# key name when it is unset.

# --- the data root: state/ (seeds, references, built arms, native stage, log corpus), runs/ (all output), notes/.
# Default <repo>/scratchpad. Seeds are reflink-copied into runs/ per run, so keep it on one CoW filesystem (btrfs/xfs).
#WJ_HOME=/path/to/wj-data

# --- sibling checkouts
IKVMCRAFT=/path/to/ikvmcraft                     # the app: frontend/, loader/, statics/
#IKVM_BUILD=/path/to/ikvm-wasm-build              # build/ikvm-runtime.sh restores from its .nuget cache
#IKVM_SRC=${IKVM_BUILD}/tools/ikvm/ikvm           # the IKVM fork (branch wasm)
#MESA_WINK=/path/to/mesa-wink                     # the GL stack (branch wink)
#FNA_WASM_BUILD=/path/to/FNA-WASM-Build           # default <repo>/../FNA-WASM-Build (build-dotnet.sh, the emsdk patches)
#DOTNET_ZIP=/path/to/dotnet-jspi.zip              # default <repo>/dotnet-jspi.zip, what build-dotnet.sh writes
#EMSDK=${IKVMCRAFT}/statics/emsdk                 # the canonical emsdk (the default)
#CHROMIUM_SRC=/path/to/chromium/src               # for checking V8 claims (v8 at src/v8)

# --- reference arms (jbox2d)
#TEAVM_DIR=/path/to/teavm                         # samples/benchmark/ikvm-bench builds the jar the HotSpot arms run
#TEAVM_BASELINE=/path/to/teavm-baseline           # served root of the 2026-07-27 TeaVM arm (`teavm`)
#JAVA_HOME_8=/usr/lib/jvm/java-8-openjdk          # autodetected under /usr/lib/jvm; set for a JDK elsewhere
#JAVA_HOME_25=/usr/lib/jvm/java-25-openjdk
#D8=/path/to/v8/out/rel/d8                        # ledger/d8x86.py (a release d8 matching the browser's V8)

# --- the native Minecraft reference (native/natrun.sh, boot/natboot.sh)
#PRISM_INSTANCE=~/.local/share/PrismLauncher/instances/MCSRRanked-Linux-1.16.1-Basic
#PRISM_HOME=~/.local/share/PrismLauncher   # autodetected; mcstage reads libraries/, assets/, meta/ from it
#NW_TAR=/path/to/ikvmcraft-mcsrranked.tar          # the pristine world, restored every run

# --- the app and browser
#CHROME_BIN=/usr/bin/chromium                     # default: chromium, chromium-browser or google-chrome-stable on PATH
#SERVE_URL=https://localhost:5021/                # where the dev server serves the app
#DEV_UNIT=ikvmcraft-dev                           # the systemd --user unit ensure-server and deploy (re)start
#DEV_CMD=pnpm dev                                 # run in $IKVMCRAFT/frontend

# --- CPU sets and PMU. Autodetected (cpu_core / cpu_atom on hybrid Intel); override only to change the policy.
#WJ_PCPUS=0-7                                     # what a measured arm is pinned to
#WJ_CENSUS_CPUS=12-15                             # where a queued census runs while the next arm boots
#WJ_BOOT_CPUS=0-11                                # boot A/Bs: every CPU but the census ones
